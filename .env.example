MENTIS_PORT=8080
JOB_WORKERS=10
RECIPE_CATEGORY_WORKERS=10

# Max upload sizes
MAX_UPLOAD_BYTES=5368709120
MAX_INLINE_UPLOAD_BYTES=5368709120

# Point this at your LocalAI instance if you want embeddings/title generation/OCR/STT.
# Example: http://host.docker.internal:8188
# On Linux, host.docker.internal is provided by compose.yaml via host-gateway.
LOCALAI_BASE_URL=
LOCALAI_EMBEDDING_MODEL=
LOCALAI_CHAT_MODEL=
LOCALAI_OCR_MODEL=
LOCALAI_STT_MODEL=

# Leave blank to disable media + backups.
MEDIA_S3_ENDPOINTS=
BACKUP_ENCRYPTION_KEY=

# Optional: four named model tiers, each independently configurable. A tier's
# model/base URL take precedence over the shared LOCALAI_* vars above. Unset
# tiers fall back to LOCALAI_BASE_URL and the matching legacy LOCALAI_* model.
export LLM_TIER_TINY_MODEL="granite-4.1-3b-Q4_K_M"      # "tiny" tier model    (title generation)
export LLM_TIER_SMALL_MODEL="gemma-4-e2b-it-qat-q4_0"     # "small" tier model   (speech-to-text)
export LLM_TIER_MEDIUM_MODEL="gemma-4-e2b-it-qat-q4_0"    # "medium" tier model  (auto-tags, OCR)
export LLM_TIER_SMART_MODEL="Qwen3.6-27B-MTP-GGUF"     # "smart" tier model   (subtask planning)

# OCR and STT are single-purpose models (they only perform one task), so they
# use dedicated model vars that take precedence over the tier model vars.
export LLM_OCR_MODEL="GLM-OCR-GGUF"            # Multimodal model for OCR
export LLM_STT_MODEL="vibevoice-cpp-asr"            # Whisper-compatible model for speech-to-text

# Feature→tier binding. Defaults if unset: title=tiny, tags=medium,
# subtasks=smart, ocr=medium, stt=small.
export LLM_FEATURE_TITLE_TIER="tiny"
export LLM_FEATURE_TAGS_TIER="tiny"
export LLM_FEATURE_SUBTASKS_TIER="smart"
