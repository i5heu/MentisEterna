# MentisEterna — secret environment variables.
#
# Non-secret settings (ports, paths, model *names*, feature→tier bindings, job
# workers, printer, etc.) live in `config.toml` — copy `config.default.toml`
# and edit that file. Only secrets stay here.
#
# See the "Secrets (environment variables)" section at the bottom of
# config.default.toml for the full list.

# Point this at your LocalAI/LLM backend. The model NAMES for each feature are
# configured in config.toml ([llm] and [llm.tiers]); only the base URL is a
# secret and stays in the environment.
# Example: http://host.docker.internal:8188
# On Linux, host.docker.internal is provided by compose.yaml via host-gateway.
LOCALAI_BASE_URL=

# Optional per-tier base URL overrides (secrets). The tier model NAMES moved to
# config.toml ([llm.tiers]); these override just the backend URL per tier.
export LLM_TIER_TINY_BASE_URL=""
export LLM_TIER_SMALL_BASE_URL=""
export LLM_TIER_MEDIUM_BASE_URL=""
export LLM_TIER_SMART_BASE_URL=""

# S3-compatible endpoints (JSON array) — required for media + encrypted backups.
# Leave blank to disable media and backups.
MEDIA_S3_ENDPOINTS=

# Hex-encoded AES-256 key for encrypted backups. Leave blank to disable backups.
BACKUP_ENCRYPTION_KEY=
