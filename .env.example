# MentisEterna — secret environment variables.
#
# All non-secret configuration (LLM base URLs, model names, feature→tier
# bindings, S3 endpoint definitions, ports, job workers, printer, etc.) lives
# in `config.toml` — copy `config.default.toml` and edit that file. Only API
# keys and the backup encryption key stay here.
#
# See the "Secrets (environment variables)" section at the bottom of
# config.default.toml for the full list.

# Hex-encoded AES-256 key for encrypted backups. Leave blank to disable backups.
BACKUP_ENCRYPTION_KEY=

# Per-endpoint S3 credentials. Replace <ID> with the endpoint id from
# `[media.endpoints]` in config.toml (upper-cased). The endpoint definition
# (bucket/region/endpoint/force_path_style) lives in config.toml — only the
# keys are secrets.
export MEDIA_S3_PRIMARY_ACCESS_KEY_ID=""
export MEDIA_S3_PRIMARY_SECRET_ACCESS_KEY=""
